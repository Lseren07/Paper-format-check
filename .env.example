APP_NAME=paper-checker
APP_ENV=development
API_HOST=127.0.0.1
# 引擎默认监听 8010，避开 Flask 5000 与 ONLYOFFICE 8080
API_PORT=8010
DATABASE_URL=sqlite:///./data/paper_checker.db

# 引擎与 Flask 共享的服务密钥（必填；为空时引擎拒绝启动）
# 生成方式：python -c "import secrets;print(secrets.token_hex(24))"
# 只写在各自机器的本地 .env 里，不进仓库、不写进日志。
FORMAT_ENGINE_KEY=

# 目录：相对路径按启动时的工作目录解析，部署时建议写绝对路径
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
PAPER_RULES_DIR=./rules
PAPER_RULES_DEFAULT=default

# 上传大小上限，需与前端、Flask 侧一致（50 MiB）
MAX_UPLOAD_SIZE_MB=50

# 过期清理：内存任务 24h；引擎报告 3 天，与用户端保留期一致
TASK_TTL_SECONDS=86400
REPORT_TTL_SECONDS=259200

# 中文 PDF 字体。留空则按平台默认查找：
#   Windows  C:\Windows\Fonts\simhei.ttf
#   Linux    /usr/share/fonts/truetype/noto/NotoSansSC-Regular.ttf
# Docker 镜像里已固定为 Noto Sans SC。
REPORT_FONT_PATH=
