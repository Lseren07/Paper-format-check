FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    REPORT_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSansSC-Regular.ttf

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

COPY docker/extract_noto_sc.py /tmp/extract_noto_sc.py
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt fonttools \
    && python /tmp/extract_noto_sc.py \
    && pip uninstall -y fonttools \
    && apt-get purge -y fonts-noto-cjk \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/extract_noto_sc.py

COPY backend /app/backend
COPY rules /app/rules
RUN mkdir -p /app/uploads /app/reports

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000"]
