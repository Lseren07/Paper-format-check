{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "rule_set_id": "electronic-tech-cdu-v1",
  "name": "电子科技大学成都学院本科毕业论文格式规范",
  "source": "附件1：电子科技大学成都学院毕业论文（设计）撰写格式规范.docx",
  "page": {
    "width_cm": 21.0,
    "height_cm": 29.7,
    "margins_cm": {
      "top": 3.5,
      "right": 3.0,
      "bottom": 3.5,
      "left": 3.0
    },
    "header_distance_cm": 2.75,
    "footer_distance_cm": 1.75
  },
  "body": {
    "font": "宋体",
    "size_pt": 12.0,
    "alignment": "justify",
    "first_line_indent_pt": 24.0,
    "line_spacing_rule": "exactly",
    "line_spacing_pt": 20.0,
    "space_before_pt": 6.0,
    "space_after_pt": 0.0
  },
  "headings": {
    "1": {
      "font": "黑体",
      "size_pt": 15.0,
      "bold": true,
      "alignment": "center",
      "space_before_pt": 30.0,
      "space_after_pt": 30.0
    },
    "2": {
      "font": "黑体",
      "size_pt": 14.0,
      "bold": true,
      "alignment": "left",
      "space_before_pt": 18.0,
      "space_after_pt": 18.0
    },
    "3": {
      "font": "黑体",
      "size_pt": 12.0,
      "bold": true,
      "alignment": "left",
      "space_before_pt": 12.0,
      "space_after_pt": 12.0
    },
    "4": {
      "font": "黑体",
      "size_pt": 12.0,
      "bold": true,
      "alignment": "left",
      "space_before_pt": 6.0,
      "space_after_pt": 6.0
    }
  },
  "manual_checks": [
    "论文结构与学校表格顺序",
    "封面和表格填写完整性",
    "目录与正文标题一致性",
    "图表编号和标题",
    "参考文献著录内容"
  ]
}
